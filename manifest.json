{
  "manifest_version": 3,
  "name": "SIGAA Dark Mode — CEFET-MG",
  "short_name": "SIGAA Dark",
  "description": "Tema Deep Dark para o portal SIGAA do CEFET-MG. Menos luz, mais foco.",
  "version": "1.0.0",
  "author": "Você mesmo",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SIGAA Dark Mode"
  },

  "content_scripts": [
    {
      "matches": [
        "https://sig.cefetmg.br/sigaa/*",
        "https://sigaa.cefetmg.br/*"
      ],
      "css": ["style.css"],
      "js":  ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "permissions": ["storage", "scripting"],

  "host_permissions": [
    "https://sig.cefetmg.br/*",
    "https://sigaa.cefetmg.br/*"
  ],

  "background": {
    "service_worker": "background.js"
  }
}
